# keep hand-written smoke-test sources; generated net + logs stay ignored
!sim/smoke/*.nod.xml
!sim/smoke/*.edg.xml
!sim/smoke/*.rou.xml
!sim/smoke/*.sumocfg
sim/smoke/*.net.xml
sim/smoke/*.log

# scratch crops + generated corridor artifacts live in repo (flatpak hides /tmp)
sim/scratch/
sim/corridor/*.net.xml
sim/corridor/*.log
!sim/corridor/*.rou.xml
# M2 generated scenario artifacts: bg rou, ev rou, per-density sumocfg, results
sim/corridor/bg.*.rou.xml
sim/corridor/ev.rou.xml
sim/corridor/corridor.*.sumocfg
sim/corridor/ev.route.json
sim/results/
